---
/**
 * Итоги: победители и фотографии. Страница есть всегда, но в меню появляется
 * и попадает в поиск только после того, как в админке включён показ итогов.
 */
import Markdown from '../../components/Markdown.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import { getLang, localeStaticPaths } from '../../i18n/routing';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCommittees, getResults } from '../../lib/content';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = getLang(Astro.params.locale);
const t = useTranslations(lang);
const [results, committees] = await Promise.all([getResults(lang), getCommittees(lang)]);

// Победители по комитетам в порядке комитетов; без комитета — в конце.
const committeeTitle = new Map(committees.map((committee) => [committee.id, committee.title]));
const groupKeys = [
  ...committees.map((committee) => committee.id),
  ...new Set(results.winners.map((winner) => winner.committee).filter((id) => !committeeTitle.has(id))),
];
const groups = groupKeys
  .map((key) => ({
    title: committeeTitle.get(key) ?? key,
    winners: results.winners.filter((winner) => winner.committee === key),
  }))
  .filter((group) => group.winners.length > 0);
---

<BaseLayout lang={lang} page="results" title={t('results.title')} noindex={!results.published}>
  <PageHeader title={t('results.title')} lead={results.published ? undefined : t('results.pending')} />

  {
    results.published && (
      <>
        <Section>
          {results.intro && <Markdown source={results.intro} class="mb-10 max-w-3xl text-lg" />}
          {groups.length > 0 && (
            <>
              <h2 class="mb-6 text-2xl font-bold">{t('results.winners')}</h2>
              <div class="grid gap-6 md:grid-cols-2">
                {groups.map((group) => (
                  <section class="rounded-2xl border border-cream-200 bg-white p-6">
                    {group.title && <h3 class="text-lg font-bold">{group.title}</h3>}
                    <ul class="mt-3 space-y-3">
                      {group.winners.map((winner) => (
                        <li>
                          <p class="text-sm font-semibold text-gold-700">{t(`award.${winner.award}`)}</p>
                          <p class="font-semibold">{winner.team}</p>
                          {winner.school && <p class="text-sm text-navy-700">{winner.school}</p>}
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </>
          )}
        </Section>

        {results.photos.length > 0 && (
          <Section title={t('results.photos')} tone="cream">
            <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              {results.photos.map((photo) => (
                <li>
                  <a href={photo}>
                    <img src={photo} alt="" loading="lazy" class="aspect-[4/3] w-full rounded-xl object-cover" />
                  </a>
                </li>
              ))}
            </ul>
          </Section>
        )}
      </>
    )
  }
</BaseLayout>
