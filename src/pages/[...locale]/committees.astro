---
/** Комитеты: темы и стартовые источники — чтобы команда выбрала комитет до регистрации. */
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import RegistrationCta from '../../components/RegistrationCta.astro';
import Section from '../../components/Section.astro';
import { getLang, localeStaticPaths } from '../../i18n/routing';
import { useTranslations } from '../../i18n/ui';
import { isIconName } from '../../icons/icons';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCommittees, getRegistration } from '../../lib/content';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = getLang(Astro.params.locale);
const t = useTranslations(lang);
const [committees, registration] = await Promise.all([getCommittees(lang), getRegistration(lang)]);
---

<BaseLayout lang={lang} page="committees" title={t('committees.title')} description={t('committees.lead')}>
  <PageHeader eyebrow={t('home.committees.eyebrow')} title={t('home.committees.title')} lead={t('committees.lead')} />

  <Section>
    <ol class="grid gap-6 lg:grid-cols-2">
      {
        committees.map((committee, index) => {
          const icon = isIconName(committee.icon) ? committee.icon : 'lightbulb';
          return (
            <li
              id={committee.id}
              class="relative scroll-mt-6 overflow-hidden rounded-3xl bg-white p-6 shadow-[0_1px_2px_rgb(16_44_81/0.06),0_16px_40px_-24px_rgb(16_44_81/0.35)] ring-1 ring-cream-200 transition-shadow target:ring-2 target:ring-gold-500 sm:p-8"
              data-reveal
              style={`--reveal-delay: ${(index % 2) * 100}ms`}
            >
              <span aria-hidden="true" class="pointer-events-none absolute -right-8 -bottom-10 text-navy-50">
                <Icon name={icon} class="size-48" strokeWidth={1.25} />
              </span>
              <div class="relative">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <span class="flex size-14 items-center justify-center rounded-2xl bg-navy-900 text-gold-400 shadow-lg shadow-navy-900/25">
                    <Icon name={icon} class="size-7" />
                  </span>
                  <span class="font-display text-sm font-bold text-navy-300 tabular-nums">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                </div>
                <h2 class="mt-5 text-2xl font-extrabold sm:text-3xl">{committee.title}</h2>
                {committee.language && (
                  <p class="mt-3 inline-flex rounded-full bg-navy-50 px-3 py-1 text-xs font-semibold text-navy-800">
                    {t('committees.language')}: {t(`language.${committee.language}`)}
                  </p>
                )}

                {committee.topics.length > 0 && (
                  <>
                    <h3 class="mt-7 text-xs font-bold tracking-[0.18em] text-gold-700 uppercase">
                      {t('committees.topics')}
                    </h3>
                    <ul class="mt-3 flex flex-wrap gap-2">
                      {committee.topics.map((topic) => (
                        <li class="rounded-full bg-navy-900 px-4 py-2 text-sm font-medium text-cream-50">{topic}</li>
                      ))}
                    </ul>
                  </>
                )}

                {committee.sources.length > 0 && (
                  <>
                    <h3 class="mt-7 text-xs font-bold tracking-[0.18em] text-gold-700 uppercase">
                      {t('committees.sources')}
                    </h3>
                    <ul class="mt-3 flex flex-wrap gap-2">
                      {committee.sources.map((source) => (
                        <li class="inline-flex items-center gap-1.5 rounded-full bg-cream-100 px-3.5 py-1.5 text-sm font-medium text-navy-800 ring-1 ring-cream-200">
                          <Icon name="book-open" class="size-3.5 text-gold-700" />
                          {source}
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>

    <div
      class="relative isolate mt-12 flex flex-col gap-6 overflow-hidden rounded-3xl bg-navy-950 p-6 text-cream-100 sm:flex-row sm:items-center sm:justify-between sm:p-10"
      data-reveal
      data-hide-sticky
    >
      <p class="max-w-md font-display text-2xl font-extrabold text-cream-50">{t('home.final.title')}</p>
      <RegistrationCta lang={lang} registration={registration} tone="dark" />
    </div>
  </Section>
</BaseLayout>
