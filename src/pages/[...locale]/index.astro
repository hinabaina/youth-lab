---
/**
 * Главная — путь посетителя, который пришёл по ссылке из Instagram и ещё не знает, что это:
 * 1. Первый экран: что это, когда и где, сколько осталось, что нажать.
 * 2. Формат: зачем саммит и три этапа дня.
 * 3. Как принять участие: шаги от команды до итогов.
 * 4. Комитеты: выбор направления.
 * 5. Программа дня.
 * 6. Как оценивает жюри.
 * 7. Что получат участники.
 * 8. Жюри и партнёры — когда появятся в админке.
 * 9. Вопросы и ответы.
 * 10. Финальный призыв и контакты.
 */
import Faq from '../../components/Faq.astro';
import Journey from '../../components/Journey.astro';
import ProgramTimeline from '../../components/ProgramTimeline.astro';
import RegistrationCta from '../../components/RegistrationCta.astro';
import Section from '../../components/Section.astro';
import Benefits from '../../components/home/Benefits.astro';
import CommitteePicker from '../../components/home/CommitteePicker.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import Format from '../../components/home/Format.astro';
import Hero from '../../components/home/Hero.astro';
import Scoring from '../../components/home/Scoring.astro';
import { getLang, localeStaticPaths } from '../../i18n/routing';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getCommittees,
  getEvent,
  getHome,
  getJury,
  getPartners,
  getProgram,
  getRegistration,
  getRules,
} from '../../lib/content';
import { formatDate, formatNumber, isoDate } from '../../lib/format';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = getLang(Astro.params.locale);
const t = useTranslations(lang);

const [event, registration, home, program, committees, jury, partners, rules] = await Promise.all([
  getEvent(lang),
  getRegistration(lang),
  getHome(lang),
  getProgram(lang),
  getCommittees(lang),
  getJury(lang),
  getPartners(),
  getRules(lang),
]);

const fee = event.fee > 0 ? `${formatNumber(event.fee, lang)} ${t('event.feeUnit')}` : t('event.free');

// Светлые блоки чередуются: кремовый — белый. Жюри и партнёры появляются, только когда их добавят в админке.
const partnersTone = jury.length > 0 ? 'cream' : 'white';
const faqTone = partners.length > 0 && partnersTone === 'cream' ? 'white' : 'cream';

// Данные для поисковиков (Google показывает такие события с датой и местом).
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.name,
  description: event.tagline || undefined,
  startDate: event.timeStart ? `${isoDate(event.date)}T${event.timeStart}` : isoDate(event.date),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: event.venue,
    address: {
      '@type': 'PostalAddress',
      streetAddress: event.address || undefined,
      addressLocality: event.city || undefined,
      addressCountry: 'KZ',
    },
  },
  organizer: { '@type': 'Organization', name: 'Youth Lab' },
  offers:
    registration.status === 'open'
      ? {
          '@type': 'Offer',
          price: event.fee,
          priceCurrency: 'KZT',
          url: registration.formUrl,
          availability: 'https://schema.org/InStock',
        }
      : undefined,
};
---

<BaseLayout lang={lang} page="home">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />

  <Hero lang={lang} event={event} registration={registration} home={home} />

  <Format lang={lang} home={home} />

  {
    home.steps.length > 0 && (
      <Section id="steps" tone="cream" title={t('home.steps.title')}>
        <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16">
          <Journey lang={lang} steps={home.steps} />
          <aside class="h-fit space-y-5 rounded-2xl bg-white p-6 ring-1 ring-cream-200 lg:sticky lg:top-24" data-reveal>
            <RegistrationCta lang={lang} registration={registration} />
            <dl class="space-y-4 border-t border-cream-200 pt-5 text-sm">
              {event.audience && (
                <div>
                  <dt class="text-navy-700">{t('event.audience')}</dt>
                  <dd class="mt-0.5 font-semibold">{event.audience}</dd>
                </div>
              )}
              {event.teamSize && (
                <div>
                  <dt class="text-navy-700">{t('event.team')}</dt>
                  <dd class="mt-0.5 font-semibold">{event.teamSize}</dd>
                </div>
              )}
              <div>
                <dt class="text-navy-700">{t('event.fee')}</dt>
                <dd class="mt-0.5 font-semibold">{fee}</dd>
                {event.feeNote && <dd class="mt-1 text-navy-700">{event.feeNote}</dd>}
              </div>
            </dl>
          </aside>
        </div>
      </Section>
    )
  }

  {
    committees.length > 0 && (
      <Section
        id="committees"
        title={t('home.committees.title')}
        lead={t('committees.lead')}
      >
        <CommitteePicker lang={lang} committees={committees} />
      </Section>
    )
  }

  {
    program.stages.length > 0 && (
      <Section
        id="program"
        tone="cream"
        title={t('home.program.title')}
        lead={[formatDate(event.date, lang), program.note].filter(Boolean).join('. ')}
      >
        <ProgramTimeline stages={program.stages} />
      </Section>
    )
  }

  {
    rules.rubrics.length > 0 && (
      <Section
        id="scoring"
        title={t('home.scoring.title')}
        lead={t('home.scoring.lead')}
      >
        <Scoring lang={lang} rubrics={rules.rubrics} />
      </Section>
    )
  }

  {
    home.benefits.length > 0 && (
      <Section id="benefits" tone="navy" title={t('home.benefits.title')}>
        <Benefits benefits={home.benefits} />
      </Section>
    )
  }

  {
    jury.length > 0 && (
      <Section id="jury" title={t('home.jury')}>
        <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
          {jury.map((member, index) => (
            <li data-reveal style={`--reveal-delay: ${(index % 4) * 80}ms`}>
              {member.photo ? (
                <img
                  src={member.photo}
                  alt=""
                  loading="lazy"
                  class="aspect-square w-full rounded-2xl bg-cream-200 object-cover"
                />
              ) : (
                <div
                  aria-hidden="true"
                  class="flex aspect-square w-full items-center justify-center rounded-2xl bg-navy-900 font-display text-4xl font-bold text-gold-400"
                >
                  {member.name.charAt(0)}
                </div>
              )}
              <h3 class="mt-4 text-lg font-bold">{member.name}</h3>
              {member.role && <p class="mt-1 text-sm text-navy-700">{member.role}</p>}
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    partners.length > 0 && (
      <Section id="partners" title={t('home.partners')} tone={partnersTone}>
        <ul class="flex flex-wrap items-center gap-x-10 gap-y-6" data-reveal>
          {partners.map((partner) => {
            const content = partner.logo ? (
              <img src={partner.logo} alt={partner.name} loading="lazy" class="h-14 w-auto max-w-[180px] object-contain" />
            ) : (
              <span class="font-display text-lg font-bold">{partner.name}</span>
            );
            return (
              <li>
                {partner.url ? (
                  <a href={partner.url} target="_blank" rel="noopener">
                    {content}
                  </a>
                ) : (
                  content
                )}
              </li>
            );
          })}
        </ul>
      </Section>
    )
  }

  {
    home.faq.length > 0 && (
      <Section
        id="faq"
        tone={faqTone}
        title={t('home.faq.title')}
        center
      >
        <Faq items={home.faq} />
      </Section>
    )
  }

  <FinalCta lang={lang} event={event} registration={registration} />
</BaseLayout>
