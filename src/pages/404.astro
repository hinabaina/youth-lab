---
/**
 * Страница 404 — одна на весь сайт, поэтому сообщение сразу на трёх языках.
 * Cloudflare Pages показывает её для любого несуществующего адреса.
 */
import '../styles/global.css';
import { localizePath } from '../i18n/routing';
import { LOCALES, useTranslations } from '../i18n/ui';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 — Youth Research Summit</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="flex min-h-dvh items-center justify-center bg-navy-900 px-4 text-cream-100">
    <main class="max-w-md py-16 text-center">
      <img src="/brand/owl-cream.png" alt="" width="96" height="109" class="mx-auto h-24 w-auto" />
      <p class="mt-6 font-display text-5xl font-extrabold text-gold-400">404</p>
      <ul class="mt-6 space-y-5">
        {
          LOCALES.map((code) => {
            const t = useTranslations(code);
            return (
              <li lang={code}>
                <p class="text-lg font-semibold text-cream-50">{t('notFound.title')}</p>
                <a href={localizePath('/', code)} class="text-gold-400 underline underline-offset-4">
                  {t('notFound.back')}
                </a>
              </li>
            );
          })
        }
      </ul>
    </main>
  </body>
</html>
