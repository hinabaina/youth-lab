---
/**
 * Фон тёмных блоков: сетка «миллиметровки» и мягкие синие свечения.
 * Золото в свечениях не используем: поверх тёмно-синего оно даёт грязно-серый оттенок.
 */
interface Props {
  /** Насколько заметны свечения: на первом экране главной — ярче. */
  intensity?: 'soft' | 'strong';
}

const { intensity = 'soft' } = Astro.props;
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
  <div
    class="absolute inset-0 bg-grid [mask-image:radial-gradient(ellipse_80%_70%_at_50%_20%,black_30%,transparent_80%)]"
  >
  </div>
  <div
    class:list={[
      'absolute -top-40 -right-32 size-[30rem] animate-drift rounded-full blur-3xl sm:size-[38rem]',
      intensity === 'strong' ? 'bg-navy-600/45' : 'bg-navy-600/30',
    ]}
  >
  </div>
  <div
    class:list={[
      'absolute -bottom-56 -left-40 size-[32rem] animate-drift rounded-full blur-3xl [animation-delay:-9s] sm:size-[40rem]',
      intensity === 'strong' ? 'bg-navy-700/60' : 'bg-navy-700/45',
    ]}
  >
  </div>
</div>
