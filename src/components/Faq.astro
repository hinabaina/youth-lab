---
/** Вопросы и ответы. Открыт может быть только один ответ, остальные сворачиваются сами. */
import Icon from './Icon.astro';
import Markdown from './Markdown.astro';

interface Props {
  items: { question: string; answer: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div
  class:list={[
    'mx-auto max-w-3xl divide-y divide-cream-200 rounded-3xl bg-white px-5 shadow-[0_1px_2px_rgb(16_44_81/0.06),0_16px_40px_-24px_rgb(16_44_81/0.35)] ring-1 ring-cream-200 sm:px-8',
    className,
  ]}
  data-reveal
>
  {
    items.map((item) => (
      <details name="faq" class="faq-item group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display text-base font-bold text-navy-900 sm:text-lg [&::-webkit-details-marker]:hidden">
          {item.question}
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-navy-50 text-navy-800 transition duration-300 group-open:rotate-45 group-open:bg-gold-500 group-open:text-navy-950">
            <Icon name="plus" class="size-4" />
          </span>
        </summary>
        {item.answer && <Markdown source={item.answer} class="pr-10 pb-6 text-navy-700" />}
      </details>
    ))
  }
</div>
