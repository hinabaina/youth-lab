---
/** Вопросы и ответы. Открыт может быть только один ответ, остальные сворачиваются сами. */
import Icon from './Icon.astro';
import Markdown from './Markdown.astro';

interface Props {
  items: { question: string; answer: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div
  class:list={[
    'mx-auto max-w-3xl divide-y divide-navy-100 border-y border-navy-200',
    className,
  ]}
  data-reveal
>
  {
    items.map((item) => (
      <details name="faq" class="faq-item group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-base font-semibold text-navy-900 sm:text-lg [&::-webkit-details-marker]:hidden">
          {item.question}
          <span class="flex size-8 shrink-0 items-center justify-center text-gold-700 transition-transform duration-300 group-open:rotate-45">
            <Icon name="plus" class="size-4" />
          </span>
        </summary>
        {item.answer && <Markdown source={item.answer} class="pr-10 pb-6 text-navy-700" />}
      </details>
    ))
  }
</div>
