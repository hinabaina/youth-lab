---
/** Заголовок внутренней страницы на тёмно-синем фоне. */
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<div class="bg-navy-900 text-cream-100">
  <div class="mx-auto max-w-6xl px-4 pt-10 pb-12 sm:px-6 sm:pt-14 sm:pb-16 lg:px-8">
    <h1 class="text-3xl font-bold text-cream-50 sm:text-4xl">{title}</h1>
    {lead && <p class="mt-4 max-w-3xl text-lg text-cream-200">{lead}</p>}
    <slot />
  </div>
</div>
