---
/** Иконка из src/icons/icons.ts. Декоративная: смысл всегда дублирует текст рядом. */
import { ICONS, type IconName } from '../icons/icons';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-5', strokeWidth = 2 } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  set:html={ICONS[name]}
/>
