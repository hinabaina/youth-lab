---
/** «Что получат участники»: три колонки на тёмном фоне. */
import { isIconName } from '../../icons/icons';
import type { getHome } from '../../lib/content';
import Icon from '../Icon.astro';

interface Props {
  benefits: Awaited<ReturnType<typeof getHome>>['benefits'];
}

const { benefits } = Astro.props;
---

<ul class:list={['grid gap-x-10 gap-y-10', benefits.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
  {
    benefits.map((benefit, index) => (
      <li class="border-t border-cream-50/20 pt-6" data-reveal style={`--reveal-delay: ${index * 120}ms`}>
        <Icon name={isIconName(benefit.icon) ? benefit.icon : 'award'} class="size-8 text-gold-400" strokeWidth={1.5} />
        <h3 class="mt-5 text-2xl font-semibold text-cream-50">{benefit.title}</h3>
        {benefit.text && <p class="mt-2 text-cream-200">{benefit.text}</p>}
      </li>
    ))
  }
</ul>
