---
/**
 * Первый экран главной. За три секунды посетитель из Instagram должен понять:
 * что это (название и подзаголовок), что он будет делать (подводка), когда и где (плашка),
 * сколько осталось (отсчёт) и что нажать дальше (кнопки).
 */
import { useTranslations, type Lang } from '../../i18n/ui';
import { isIconName } from '../../icons/icons';
import type { getEvent, getHome, getRegistration } from '../../lib/content';
import { formatDate, formatWeekday, instagramUrl, isoDate } from '../../lib/format';
import Countdown from '../Countdown.astro';
import HeroBackdrop from '../HeroBackdrop.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  event: Awaited<ReturnType<typeof getEvent>>;
  registration: Awaited<ReturnType<typeof getRegistration>>;
  home: Awaited<ReturnType<typeof getHome>>;
}

const { lang, event, registration, home } = Astro.props;
const t = useTranslations(lang);

// «Research» в названии подсвечиваем золотом, если это слово там есть.
const nameMatch = event.name.match(/^(.*?)(Research)(.*)$/);
const time = event.timeStart ? [event.timeStart, event.timeEnd].filter(Boolean).join('–') : '';
const { status, formUrl, opensOn, deadline, note } = registration;
const statusText =
  status === 'soon'
    ? opensOn
      ? t('cta.opensOn', { date: formatDate(opensOn, lang) })
      : t('cta.soon')
    : status === 'closed'
      ? t('cta.closed')
      : deadline
        ? t('cta.deadline', { date: formatDate(deadline, lang) })
        : '';
// Повторять ту же мысль дважды незачем: примечание показываем, только если оно добавляет что-то новое.
const showNote = note && status !== 'open' && !note.startsWith(statusText);
const orbit = home.format.slice(0, 3);
---

<section class="relative isolate overflow-hidden bg-navy-950 text-cream-100" data-hero>
  <HeroBackdrop intensity="strong" />

  <img
    src="/brand/owl-cream-lg.webp"
    alt=""
    width="480"
    height="545"
    class="pointer-events-none absolute -top-4 -right-20 -z-10 w-64 rotate-6 opacity-[0.07] sm:w-80 lg:hidden"
  />

  <div
    class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-8 pb-16 sm:px-6 sm:pt-14 sm:pb-20 lg:grid-cols-[minmax(0,1fr)_25rem] lg:px-8 lg:pt-16 lg:pb-24 xl:grid-cols-[minmax(0,1fr)_28rem]"
  >
    <div>
      <p
        class="inline-flex flex-wrap items-center gap-x-4 gap-y-1 rounded-full bg-white/[0.06] px-4 py-1.5 text-sm font-medium text-cream-100 ring-1 ring-white/10 backdrop-blur-sm"
      >
        <span class="inline-flex items-center gap-1.5">
          <Icon name="calendar-days" class="size-4 text-gold-400" />
          <time datetime={isoDate(event.date)}>{formatDate(event.date, lang)}, {formatWeekday(event.date, lang)}</time>
          {time && <span class="text-cream-200">· {time}</span>}
        </span>
        {
          event.city && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name="map-pin" class="size-4 text-gold-400" />
              {event.city}
            </span>
          )
        }
      </p>

      <h1
        class="mt-6 text-[2.6rem] leading-[1.02] font-extrabold tracking-tight text-cream-50 min-[400px]:text-5xl sm:text-6xl lg:text-7xl"
      >
        {
          nameMatch ? (
            <>
              {nameMatch[1]}
              <span class="bg-linear-to-r from-gold-300 via-gold-400 to-gold-500 bg-clip-text text-transparent">
                {nameMatch[2]}
              </span>
              {nameMatch[3]}
            </>
          ) : (
            event.name
          )
        }
      </h1>

      {event.tagline && <p class="mt-5 text-lg font-semibold text-gold-200 sm:text-xl">{event.tagline}</p>}
      {home.lead && <p class="mt-3 max-w-xl text-base text-cream-200 sm:text-lg">{home.lead}</p>}

      <Countdown lang={lang} date={event.date} timeStart={event.timeStart} class="mt-8 max-w-md" />

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        {
          status === 'open' ? (
            <a
              href={formUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-gold-500 px-7 py-3.5 font-display text-base font-bold text-navy-950 shadow-lg shadow-gold-500/20 transition hover:-translate-y-0.5 hover:bg-gold-400"
            >
              {t('cta.open')}
              <Icon name="arrow-up-right" class="size-4" />
              <span class="sr-only">({t('a11y.newTab')})</span>
            </a>
          ) : (
            <a
              href="#format"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-gold-500 px-7 py-3.5 font-display text-base font-bold text-navy-950 shadow-lg shadow-gold-500/20 transition hover:-translate-y-0.5 hover:bg-gold-400"
            >
              {t('hero.how')}
              <Icon name="arrow-down" class="size-4" />
            </a>
          )
        }
        {
          status === 'open' ? (
            <a
              href="#format"
              class="inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 font-semibold text-cream-50 ring-1 ring-white/25 transition hover:bg-white/10"
            >
              {t('hero.how')}
              <Icon name="arrow-down" class="size-4" />
            </a>
          ) : (
            event.instagram && (
              <a
                href={instagramUrl(event.instagram)}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 font-semibold text-cream-50 ring-1 ring-white/25 transition hover:bg-white/10"
              >
                <Icon name="instagram" class="size-4" />
                {t('hero.follow')}
                <span class="sr-only">({t('a11y.newTab')})</span>
              </a>
            )
          )
        }
      </div>

      {
        statusText && (
          <p class="mt-5 flex items-start gap-2.5 text-sm text-cream-200">
            <span
              class:list={[
                'mt-1.5 size-2 shrink-0 rounded-full',
                status === 'closed' ? 'bg-cream-300' : 'animate-pulse-dot bg-gold-400',
              ]}
            />
            <span>
              <span class="font-semibold text-cream-50">{statusText}</span>
              {showNote && <>{/[.!?]$/.test(statusText) ? ' ' : '. '}{note}</>}
            </span>
          </p>
        )
      }
    </div>

    <div class="relative mx-auto hidden aspect-square w-full lg:block" aria-hidden="true">
      <div class="absolute inset-0 animate-orbit rounded-full border border-dashed border-gold-400/40">
        <span
          class="absolute top-1/2 -left-1.5 size-3 rounded-full bg-gold-400 shadow-[0_0_18px_4px_rgb(223_184_83/0.6)]"
        >
        </span>
      </div>
      <div class="absolute inset-10 animate-orbit-reverse rounded-full border border-white/10">
        <span class="absolute -top-1 left-1/2 size-2 rounded-full bg-cream-200/70"></span>
      </div>
      <div
        class="absolute inset-20 rounded-full bg-radial from-navy-800 to-navy-900 shadow-[0_0_90px_-10px_rgb(212_166_58/0.35)] ring-1 ring-white/10"
      >
      </div>
      <img
        src="/brand/owl-cream-lg.webp"
        alt=""
        width="480"
        height="545"
        class="absolute inset-0 m-auto w-[38%] drop-shadow-[0_10px_30px_rgba(0,0,0,0.35)]"
      />
      {
        orbit.map((item, index) => (
          <div
            class:list={[
              'absolute flex animate-float items-center gap-3 rounded-2xl bg-navy-900/70 py-2.5 pr-4 pl-2.5 ring-1 ring-white/15 backdrop-blur-md',
              index === 0 && 'top-[8%] -left-[6%]',
              index === 1 && 'top-[46%] -right-[10%] [animation-delay:-2.3s]',
              index === 2 && 'bottom-[6%] left-[4%] [animation-delay:-4.6s]',
            ]}
          >
            <span class="flex size-9 items-center justify-center rounded-xl bg-gold-500 text-navy-950">
              <Icon name={isIconName(item.icon) ? item.icon : 'sparkles'} class="size-5" />
            </span>
            <span>
              <span class="block font-display text-sm font-bold text-cream-50">{item.title}</span>
              {item.meta && <span class="block text-xs text-cream-200">{item.meta}</span>}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
