---
/**
 * Первый экран главной. За три секунды посетитель из Instagram должен понять:
 * что это (название и подзаголовок), что он будет делать (подводка), когда и где (строка над названием),
 * сколько осталось (отсчёт) и что нажать дальше (кнопки).
 */
import { useTranslations, type Lang } from '../../i18n/ui';
import { isIconName } from '../../icons/icons';
import type { getEvent, getHome, getRegistration } from '../../lib/content';
import { formatDate, formatWeekday, instagramUrl, isoDate } from '../../lib/format';
import Countdown from '../Countdown.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  event: Awaited<ReturnType<typeof getEvent>>;
  registration: Awaited<ReturnType<typeof getRegistration>>;
  home: Awaited<ReturnType<typeof getHome>>;
}

const { lang, event, registration, home } = Astro.props;
const t = useTranslations(lang);

// «Research» в названии набираем золотым курсивом, если это слово там есть.
const nameMatch = event.name.match(/^(.*?)(Research)(.*)$/);
const time = event.timeStart ? [event.timeStart, event.timeEnd].filter(Boolean).join('–') : '';
const { status, formUrl, opensOn, deadline, note } = registration;
const statusText =
  status === 'soon'
    ? opensOn
      ? t('cta.opensOn', { date: formatDate(opensOn, lang) })
      : t('cta.soon')
    : status === 'closed'
      ? t('cta.closed')
      : deadline
        ? t('cta.deadline', { date: formatDate(deadline, lang) })
        : '';
// Повторять ту же мысль дважды незачем: примечание показываем, только если оно добавляет что-то новое.
const showNote = note && status !== 'open' && !note.startsWith(statusText);
---

<section class="relative isolate overflow-hidden bg-navy-950 text-cream-100" data-hero>
  <div
    class="mx-auto grid max-w-6xl gap-10 px-4 pt-9 pb-14 sm:px-6 sm:pt-14 sm:pb-20 lg:grid-cols-[minmax(0,1fr)_22rem] lg:px-8 lg:pt-20 lg:pb-24"
  >
    <div>
      <p class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm font-medium text-gold-300 sm:text-base">
        <time datetime={isoDate(event.date)}>{formatDate(event.date, lang)}, {formatWeekday(event.date, lang)}</time>
        {time && <span>· {time}</span>}
        {event.city && <span>· {event.city}</span>}
      </p>

      <h1
        class="mt-5 text-[2.75rem] leading-[1.02] font-semibold tracking-[-0.02em] text-cream-50 min-[400px]:text-5xl sm:text-6xl lg:text-7xl"
      >
        {
          nameMatch ? (
            <>
              {nameMatch[1]}
              <em class="font-medium text-gold-400">{nameMatch[2]}</em>
              {nameMatch[3]}
            </>
          ) : (
            event.name
          )
        }
      </h1>

      {event.tagline && <p class="mt-6 max-w-xl text-lg font-medium text-cream-50 sm:text-xl">{event.tagline}</p>}
      {home.lead && <p class="mt-3 max-w-xl text-base text-cream-200 sm:text-lg">{home.lead}</p>}

      <Countdown lang={lang} date={event.date} timeStart={event.timeStart} class="mt-9 max-w-md" />

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        {
          status === 'open' ? (
            <a
              href={formUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-gold-500 px-6 py-3.5 text-base font-semibold text-navy-950 transition-colors hover:bg-gold-400"
            >
              {t('cta.open')}
              <Icon name="arrow-up-right" class="size-4" />
              <span class="sr-only">({t('a11y.newTab')})</span>
            </a>
          ) : (
            <a
              href="#format"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-gold-500 px-6 py-3.5 text-base font-semibold text-navy-950 transition-colors hover:bg-gold-400"
            >
              {t('hero.how')}
              <Icon name="arrow-down" class="size-4" />
            </a>
          )
        }
        {
          status === 'open' ? (
            <a
              href="#format"
              class="inline-flex items-center justify-center gap-2 rounded-lg px-5 py-3.5 font-semibold text-cream-50 ring-1 ring-cream-50/30 transition-colors hover:bg-cream-50/10"
            >
              {t('hero.how')}
              <Icon name="arrow-down" class="size-4" />
            </a>
          ) : (
            event.instagram && (
              <a
                href={instagramUrl(event.instagram)}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center justify-center gap-2 rounded-lg px-5 py-3.5 font-semibold text-cream-50 ring-1 ring-cream-50/30 transition-colors hover:bg-cream-50/10"
              >
                <Icon name="instagram" class="size-4" />
                {t('hero.follow')}
                <span class="sr-only">({t('a11y.newTab')})</span>
              </a>
            )
          )
        }
      </div>

      {
        statusText && (
          <p class="mt-5 flex items-start gap-2.5 text-sm text-cream-200">
            <span class:list={['mt-1.5 size-2 shrink-0 rounded-full', status === 'closed' ? 'bg-cream-300' : 'bg-gold-400']} />
            <span>
              <span class="font-semibold text-cream-50">{statusText}</span>
              {showNote && <>{/[.!?]$/.test(statusText) ? ' ' : '. '}{note}</>}
            </span>
          </p>
        )
      }
    </div>

    <figure class="hidden self-center lg:block" aria-hidden="true">
      <img src="/brand/owl-cream-lg.webp" alt="" width="480" height="545" class="ml-auto w-[19rem]" />
    </figure>
  </div>
</section>
