---
/**
 * Комитеты на главной: плитки с иконками, по нажатию — направления и стартовые источники.
 * Без JavaScript плитки не видны, а все комитеты идут списком.
 */
import { localizePath, PAGES } from '../../i18n/routing';
import { useTranslations, type Lang } from '../../i18n/ui';
import { isIconName } from '../../icons/icons';
import type { getCommittees } from '../../lib/content';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  committees: Awaited<ReturnType<typeof getCommittees>>;
}

const { lang, committees } = Astro.props;
const t = useTranslations(lang);
const total = String(committees.length);
---

<div class="grid gap-6 lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-8" data-tabs data-tabs-scroll>
  <div role="tablist" aria-label={t('home.committees.title')} class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-1" hidden>
    {
      committees.map((committee, index) => (
        <button
          type="button"
          role="tab"
          id={`committee-tab-${committee.id}`}
          aria-controls={`committee-panel-${committee.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          class="group flex min-h-16 flex-col items-start gap-2.5 rounded-2xl bg-white p-3 text-left ring-1 ring-cream-200 transition duration-200 hover:ring-gold-400 aria-selected:bg-navy-900 aria-selected:text-cream-50 aria-selected:shadow-lg aria-selected:shadow-navy-900/20 aria-selected:ring-navy-900 lg:flex-row lg:items-center lg:gap-3"
        >
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-gold-100 text-gold-700 transition-colors group-aria-selected:bg-gold-500 group-aria-selected:text-navy-950">
            <Icon name={isIconName(committee.icon) ? committee.icon : 'lightbulb'} class="size-5" />
          </span>
          <span class="min-w-0 font-display text-sm leading-snug font-bold break-words sm:text-[0.95rem]">{committee.title}</span>
        </button>
      ))
    }
  </div>

  <div class="space-y-6">
    {
      committees.map((committee, index) => (
        <article
          role="tabpanel"
          id={`committee-panel-${committee.id}`}
          aria-labelledby={`committee-tab-${committee.id}`}
          tabindex="0"
          class="relative overflow-hidden rounded-3xl bg-white p-6 shadow-[0_1px_2px_rgb(16_44_81/0.06),0_16px_40px_-20px_rgb(16_44_81/0.35)] ring-1 ring-cream-200 sm:p-9"
        >
          <span aria-hidden="true" class="pointer-events-none absolute -right-8 -bottom-10 text-navy-50">
            <Icon name={isIconName(committee.icon) ? committee.icon : 'lightbulb'} class="size-56" strokeWidth={1.25} />
          </span>
          <div class="relative">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="flex size-14 items-center justify-center rounded-2xl bg-navy-900 text-gold-400 shadow-lg shadow-navy-900/25">
                <Icon name={isIconName(committee.icon) ? committee.icon : 'lightbulb'} class="size-7" />
              </span>
              <span class="font-display text-sm font-bold text-navy-300 tabular-nums">
                {t('committees.count', { n: String(index + 1), total })}
              </span>
            </div>
            <h3 class="mt-5 text-2xl font-extrabold sm:text-3xl">{committee.title}</h3>
            {committee.language && (
              <p class="mt-3 inline-flex rounded-full bg-navy-50 px-3 py-1 text-xs font-semibold text-navy-800">
                {t('committees.language')}: {t(`language.${committee.language}`)}
              </p>
            )}

            {committee.topics.length > 0 && (
              <>
                <h4 class="mt-7 text-xs font-bold tracking-[0.18em] text-gold-700 uppercase">{t('committees.topics')}</h4>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {committee.topics.map((topic) => (
                    <li class="rounded-full bg-navy-900 px-4 py-2 text-sm font-medium text-cream-50">{topic}</li>
                  ))}
                </ul>
              </>
            )}

            {committee.sources.length > 0 && (
              <>
                <h4 class="mt-7 text-xs font-bold tracking-[0.18em] text-gold-700 uppercase">{t('committees.sources')}</h4>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {committee.sources.map((source) => (
                    <li class="inline-flex items-center gap-1.5 rounded-full bg-cream-100 px-3.5 py-1.5 text-sm font-medium text-navy-800 ring-1 ring-cream-200">
                      <Icon name="book-open" class="size-3.5 text-gold-700" />
                      {source}
                    </li>
                  ))}
                </ul>
              </>
            )}

            <a
              href={`${localizePath(PAGES.committees, lang)}#${committee.id}`}
              class="mt-8 inline-flex items-center gap-2 font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4 hover:decoration-navy-900"
            >
              {t('committees.more')}
              <Icon name="arrow-right" class="size-4" />
            </a>
          </div>
        </article>
      ))
    }
  </div>
</div>
