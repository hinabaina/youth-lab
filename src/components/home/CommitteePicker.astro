---
/**
 * Комитеты на главной: список-вкладки, по нажатию — направления и стартовые источники.
 * Без JavaScript плитки не видны, а все комитеты идут списком.
 */
import { localizePath, PAGES } from '../../i18n/routing';
import { useTranslations, type Lang } from '../../i18n/ui';
import { isIconName } from '../../icons/icons';
import type { getCommittees } from '../../lib/content';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  committees: Awaited<ReturnType<typeof getCommittees>>;
}

const { lang, committees } = Astro.props;
const t = useTranslations(lang);
const total = String(committees.length);
---

<div class="grid gap-6 lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-8" data-tabs data-tabs-scroll>
  <div role="tablist" aria-label={t('home.committees.title')} class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-1" hidden>
    {
      committees.map((committee, index) => (
        <button
          type="button"
          role="tab"
          id={`committee-tab-${committee.id}`}
          aria-controls={`committee-panel-${committee.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          class="group flex min-h-14 flex-col items-start gap-2 rounded-lg bg-white px-3 py-3 text-left ring-1 ring-cream-200 transition-colors hover:ring-navy-300 aria-selected:bg-navy-900 aria-selected:text-cream-50 aria-selected:ring-navy-900 lg:flex-row lg:items-center lg:gap-3"
        >
          <Icon name={isIconName(committee.icon) ? committee.icon : 'lightbulb'} class="size-5 shrink-0 text-gold-700 group-aria-selected:text-gold-400" />
          <span class="min-w-0 text-sm leading-snug font-semibold break-words sm:text-[0.95rem]">{committee.title}</span>
        </button>
      ))
    }
  </div>

  <div class="space-y-6">
    {
      committees.map((committee, index) => (
        <article
          role="tabpanel"
          id={`committee-panel-${committee.id}`}
          aria-labelledby={`committee-tab-${committee.id}`}
          tabindex="0"
          class="rounded-2xl bg-white p-6 ring-1 ring-cream-200 sm:p-9"
        >
          <div>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <Icon name={isIconName(committee.icon) ? committee.icon : 'lightbulb'} class="size-9 text-gold-600" strokeWidth={1.5} />
              <span class="text-sm font-medium text-navy-700 tabular-nums">
                {t('committees.count', { n: String(index + 1), total })}
              </span>
            </div>
            <h3 class="mt-4 text-2xl font-semibold sm:text-3xl">{committee.title}</h3>
            {committee.language && (
              <p class="mt-3 inline-flex rounded-full bg-navy-50 px-3 py-1 text-xs font-semibold text-navy-800">
                {t('committees.language')}: {t(`language.${committee.language}`)}
              </p>
            )}

            {committee.topics.length > 0 && (
              <>
                <h4 class="mt-7 text-sm font-semibold text-navy-700">{t('committees.topics')}</h4>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {committee.topics.map((topic) => (
                    <li class="rounded-full px-3.5 py-1.5 text-sm font-medium text-navy-900 ring-1 ring-navy-200">{topic}</li>
                  ))}
                </ul>
              </>
            )}

            {committee.sources.length > 0 && (
              <>
                <h4 class="mt-7 text-sm font-semibold text-navy-700">{t('committees.sources')}</h4>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {committee.sources.map((source) => (
                    <li class="inline-flex items-center gap-1.5 rounded-full bg-cream-100 px-3.5 py-1.5 text-sm font-medium text-navy-800">
                      <Icon name="book-open" class="size-3.5 text-gold-700" />
                      {source}
                    </li>
                  ))}
                </ul>
              </>
            )}

            <a
              href={`${localizePath(PAGES.committees, lang)}#${committee.id}`}
              class="mt-8 inline-flex items-center gap-2 font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4 hover:decoration-navy-900"
            >
              {t('committees.more')}
              <Icon name="arrow-right" class="size-4" />
            </a>
          </div>
        </article>
      ))
    }
  </div>
</div>
