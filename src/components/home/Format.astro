---
/** «Формат»: зачем саммит (текст «О саммите») и три этапа дня колонками, под ними — цифры. */
import { useTranslations, type Lang } from '../../i18n/ui';
import { isIconName } from '../../icons/icons';
import type { getHome } from '../../lib/content';
import Icon from '../Icon.astro';
import Markdown from '../Markdown.astro';
import Section from '../Section.astro';

interface Props {
  lang: Lang;
  home: Awaited<ReturnType<typeof getHome>>;
}

const { lang, home } = Astro.props;
const t = useTranslations(lang);
---

<Section id="format" title={t('home.format.title')}>
  {home.about && <Markdown slot="lead" source={home.about} />}

  {
    home.format.length > 0 && (
      <ol class="grid gap-x-10 gap-y-10 md:grid-cols-3">
        {home.format.map((item, index) => (
          <li class="border-t-2 border-navy-900 pt-5" data-reveal style={`--reveal-delay: ${index * 120}ms`}>
            <div class="flex items-baseline justify-between gap-4">
              <span aria-hidden="true" class="font-display text-5xl leading-none font-medium text-gold-600 italic">
                {index + 1}
              </span>
              {item.meta && (
                <p class="inline-flex items-center gap-1.5 text-sm font-medium text-navy-700">
                  <Icon name={isIconName(item.icon) ? item.icon : 'clock'} class="size-4 text-gold-700" />
                  {item.meta}
                </p>
              )}
            </div>
            <h3 class="mt-4 text-2xl font-semibold">{item.title}</h3>
            {item.text && <p class="mt-3 text-navy-700">{item.text}</p>}
          </li>
        ))}
      </ol>
    )
  }

  {
    home.facts.length > 0 && (
      <ul class="mt-14 grid grid-cols-2 gap-x-6 gap-y-8 rounded-2xl bg-cream-100 px-6 py-8 sm:px-8 md:grid-cols-4" data-reveal>
        {home.facts.map((fact) => {
          const numeric = /^\d+$/.test(fact.value);
          return (
            <li>
              <p class="font-display text-4xl font-medium text-navy-900 tabular-nums sm:text-5xl">
                {numeric ? <span data-count={fact.value}>{fact.value}</span> : fact.value}
              </p>
              <p class="mt-2 text-sm text-navy-700">{fact.label}</p>
            </li>
          );
        })}
      </ul>
    )
  }
</Section>
