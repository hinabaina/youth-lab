---
/** Финальный блок главной: призыв, регистрация и все способы связаться. */
import { useTranslations, type Lang } from '../../i18n/ui';
import type { getEvent, getRegistration } from '../../lib/content';
import { formatDate, formatPhone, instagramHandle, instagramUrl, phoneHref } from '../../lib/format';
import Icon from '../Icon.astro';
import RegistrationCta from '../RegistrationCta.astro';

interface Props {
  lang: Lang;
  event: Awaited<ReturnType<typeof getEvent>>;
  registration: Awaited<ReturnType<typeof getRegistration>>;
}

const { lang, event, registration } = Astro.props;
const t = useTranslations(lang);
const place = [event.venue, event.address, event.city].filter(Boolean).join(', ');
---

<section id="contacts" class="scroll-mt-4 bg-cream-50 px-4 pt-2 pb-16 sm:px-6 sm:pb-24 lg:px-8" data-hide-sticky>
  <div
    class="relative isolate mx-auto max-w-6xl overflow-hidden rounded-2xl bg-navy-950 px-6 py-12 text-cream-100 sm:px-12 sm:py-16 lg:px-16"
  >
    <img
      src="/brand/owl-cream-lg.webp"
      alt=""
      width="480"
      height="545"
      class="pointer-events-none absolute -right-10 -bottom-16 -z-10 w-64 opacity-[0.08] sm:w-80 lg:right-10 lg:w-96"
    />

    <div class="max-w-2xl" data-reveal>
      <p class="font-medium text-gold-300">{formatDate(event.date, lang)}</p>
      <h2 class="mt-3 text-[2rem] leading-[1.08] font-semibold tracking-[-0.015em] text-cream-50 sm:text-5xl">
        {t('home.final.title')}
      </h2>
      <div class="mt-8">
        <RegistrationCta lang={lang} registration={registration} tone="dark" />
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-8" data-reveal>
      <p class="text-cream-200">{t('home.final.questions')}</p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          event.instagram && (
            <li>
              <a
                href={instagramUrl(event.instagram)}
                target="_blank"
                rel="noopener"
                class="flex h-full items-center gap-4 rounded-xl p-4 ring-1 ring-cream-50/15 transition-colors hover:bg-cream-50/5"
              >
                <span class="flex shrink-0 text-gold-400">
                  <Icon name="instagram" class="size-6" strokeWidth={1.75} />
                </span>
                <span>
                  <span class="block text-xs text-cream-200">{t('contacts.instagram')}</span>
                  <span class="block font-semibold text-cream-50">@{instagramHandle(event.instagram)}</span>
                </span>
                <span class="sr-only">({t('a11y.newTab')})</span>
              </a>
            </li>
          )
        }
        {
          event.phone && (
            <li>
              <a
                href={phoneHref(event.phone)}
                class="flex h-full items-center gap-4 rounded-xl p-4 ring-1 ring-cream-50/15 transition-colors hover:bg-cream-50/5"
              >
                <span class="flex shrink-0 text-gold-400">
                  <Icon name="phone" class="size-6" strokeWidth={1.75} />
                </span>
                <span>
                  <span class="block text-xs text-cream-200">{t('contacts.phone')}</span>
                  <span class="block font-semibold text-cream-50">{formatPhone(event.phone)}</span>
                </span>
              </a>
            </li>
          )
        }
        {
          event.email && (
            <li>
              <a
                href={`mailto:${event.email}`}
                class="flex h-full items-center gap-4 rounded-xl p-4 ring-1 ring-cream-50/15 transition-colors hover:bg-cream-50/5"
              >
                <span class="flex shrink-0 text-gold-400">
                  <Icon name="mail" class="size-6" strokeWidth={1.75} />
                </span>
                <span class="min-w-0">
                  <span class="block text-xs text-cream-200">{t('contacts.email')}</span>
                  <span class="block truncate font-semibold text-cream-50">{event.email}</span>
                </span>
              </a>
            </li>
          )
        }
        {
          place && (
            <li>
              {event.mapUrl ? (
                <a
                  href={event.mapUrl}
                  target="_blank"
                  rel="noopener"
                  class="flex h-full items-center gap-4 rounded-xl p-4 ring-1 ring-cream-50/15 transition-colors hover:bg-cream-50/5"
                >
                  <span class="flex shrink-0 text-gold-400">
                    <Icon name="map-pin" class="size-6" strokeWidth={1.75} />
                  </span>
                  <span>
                    <span class="block text-xs text-cream-200">{t('event.map')}</span>
                    <span class="block font-semibold text-cream-50">{place}</span>
                  </span>
                  <span class="sr-only">({t('a11y.newTab')})</span>
                </a>
              ) : (
                <div class="flex h-full items-center gap-4 rounded-xl p-4 ring-1 ring-cream-50/15">
                  <span class="flex shrink-0 text-gold-400">
                    <Icon name="map-pin" class="size-6" strokeWidth={1.75} />
                  </span>
                  <span>
                    <span class="block text-xs text-cream-200">{t('contacts.address')}</span>
                    <span class="block font-semibold text-cream-50">{place}</span>
                  </span>
                </div>
              )}
            </li>
          )
        }
      </ul>
    </div>
  </div>
</section>
