---
/**
 * Шапка: сова и название, меню, переключатель языка.
 * На телефоне меню прячется под кнопку «Меню» (работает без JavaScript).
 */
import { localizePath, PAGES, type PageKey } from '../i18n/routing';
import { useTranslations, type Lang } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  page: PageKey | null;
  siteName: string;
  /** Пункт «Итоги» появляется, когда в админке включён показ итогов. */
  showResults: boolean;
}

const { lang, page, siteName, showResults } = Astro.props;
const t = useTranslations(lang);

const items = (['committees', 'rules', 'register', 'results'] as const)
  .filter((key) => key !== 'results' || showResults)
  .map((key) => ({ key, href: localizePath(PAGES[key], lang), label: t(`nav.${key}`) }));
const mobileItems = [{ key: 'home' as const, href: localizePath('/', lang), label: t('nav.home') }, ...items];
---

<header class="relative bg-navy-900 text-cream-100">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href={localizePath('/', lang)} class="flex items-center gap-3 rounded-md">
      <img src="/brand/owl-cream.png" alt="" width="40" height="45" class="h-10 w-auto" />
      <span class="font-display text-base leading-tight font-bold tracking-tight sm:text-lg">{siteName}</span>
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      <nav aria-label={t('nav.label')}>
        <ul class="flex items-center gap-1">
          {
            items.map(({ key, href, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={page === key ? 'page' : undefined}
                  class="rounded-full px-3 py-2 text-sm font-medium hover:bg-navy-800 aria-[current=page]:text-gold-400"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <LanguageSwitcher lang={lang} page={page} />
    </div>

    <details class="group lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-navy-700 px-4 py-2 text-sm font-semibold [&::-webkit-details-marker]:hidden"
      >
        {t('nav.menu')}
        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 transition-transform group-open:rotate-180">
          <path d="M5 7.5 10 12.5 15 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <div
        class="absolute inset-x-0 z-40 mt-3 border-t border-navy-800 bg-navy-900 px-4 pt-2 pb-5 shadow-xl sm:px-6"
      >
        <nav aria-label={t('nav.label')}>
          <ul class="flex flex-col">
            {
              mobileItems.map(({ key, href, label }) => (
                <li>
                  <a
                    href={href}
                    aria-current={page === key ? 'page' : undefined}
                    class="block rounded-lg px-3 py-3 text-base font-medium hover:bg-navy-800 aria-[current=page]:text-gold-400"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <LanguageSwitcher lang={lang} page={page} class="mt-3 px-1" />
      </div>
    </details>
  </div>
</header>
