---
/**
 * Кнопка или статус регистрации — зависит от настроек в админке (раздел «Регистрация»):
 * «Открыта» — кнопка на форму, «Скоро откроется» — дата открытия, если известна, «Закрыта» — плашка.
 */
import { useTranslations, type Lang } from '../i18n/ui';
import type { getRegistration } from '../lib/content';
import { formatDate } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  registration: Awaited<ReturnType<typeof getRegistration>>;
  /** dark — на тёмно-синем фоне, light — на светлом. */
  tone?: 'dark' | 'light';
  showNote?: boolean;
}

const { lang, registration, tone = 'light', showNote = true } = Astro.props;
const t = useTranslations(lang);
const { status, formUrl, opensOn, deadline, note } = registration;

const pill =
  tone === 'dark'
    ? 'bg-white/[0.06] text-cream-50 ring-white/15'
    : 'bg-white text-navy-900 ring-cream-200';
const soonText = opensOn ? t('cta.opensOn', { date: formatDate(opensOn, lang) }) : t('cta.soon');
// Примечание, которое повторяет статус, не показываем второй раз.
const visibleNote = showNote && note && !(status === 'soon' && note.startsWith(soonText)) ? note : '';
---

<div class="flex flex-col items-start gap-3">
  {
    status === 'open' && (
      <a
        href={formUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-gold-500 px-7 py-3.5 font-display text-base font-bold text-navy-950 shadow-lg shadow-gold-500/20 transition hover:-translate-y-0.5 hover:bg-gold-400"
      >
        {t('cta.open')}
        <Icon name="arrow-up-right" class="size-4" />
        <span class="sr-only">({t('a11y.newTab')})</span>
      </a>
    )
  }
  {
    status === 'soon' && (
      <p class:list={['inline-flex items-center gap-3 rounded-full px-5 py-3 font-semibold ring-1', pill]}>
        <span aria-hidden="true" class="size-2.5 animate-pulse-dot rounded-full bg-gold-500" />
        {soonText}
      </p>
    )
  }
  {
    status === 'closed' && (
      <p class:list={['inline-flex rounded-full px-5 py-3 font-semibold ring-1', pill]}>{t('cta.closed')}</p>
    )
  }
  {
    status === 'open' && deadline && (
      <p class:list={['text-sm', tone === 'dark' ? 'text-cream-200' : 'text-navy-700']}>
        {t('cta.deadline', { date: formatDate(deadline, lang) })}
      </p>
    )
  }
  {
    visibleNote && (
      <p class:list={['max-w-prose text-sm', tone === 'dark' ? 'text-cream-200' : 'text-navy-700']}>{visibleNote}</p>
    )
  }
</div>
